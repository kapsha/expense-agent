{
  "name": "expense-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p server/tsconfig.json && (cd web && vite build)",
    "test": "vitest run",
    "eval": "[ -f evals/promptfooconfig.yaml ] && promptfoo eval -c evals/promptfooconfig.yaml || echo 'Evals not configured yet — skipping'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "==0.125.0",
    "@hono/node-server": "==2.1.1",
    "hono": "==4.13.7",
    "zod": "==4.6.4"
  },
  "devDependencies": {
    "@types/node": "==26.5.1",
    "tsx": "==4.23.13",
    "typescript": "==7.0.2",
    "vite": "==8.3.0",
    "vitest": "==5.0.0"
  }
}
